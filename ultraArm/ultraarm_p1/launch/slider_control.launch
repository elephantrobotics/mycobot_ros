<launch>

    <arg name="model" default="$(find mycobot_description)/urdf/ultraArm_p1/ultraArm_p1.urdf"/>
    <arg name="rvizconfig" default="$(find ultraarm_p1)/config/ultraArm_P1.rviz" />

    <param name="robot_description" command="$(find xacro)/xacro --inorder $(arg model)" />

    <!-- GUI slider -->
    <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui">
        <remap from="/joint_states" to="/joint_states_raw"/>
    </node>

    <!-- coupling node -->
    <node pkg="ultraarm_p1" type="joint_coupling_node.py" name="joint_coupling_node"/>
    <!-- Popup when J2-J3 coupling is violated (slider / Randomize) -->
    <node pkg="ultraarm_p1" type="coupling_warn_gui.py" name="coupling_warn_gui" output="screen"/>

    <!-- TF -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- RViz -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)" required="true" />

</launch>