<launch>
	<!-- Select connecting device and serial-->

	<arg name="port" default="/dev/ttyUSB0" />
	<arg name="baud" default="1000000" />
	<arg name="state_rate" default="10.0" />


	<!-- Open communication topics ，开启通讯服务-->
	<node name="mycobot_topics" pkg="ultraarm_communication" type="mycobot_topics.py" output="screen">
		<param name="port" type="string" value="$(arg port)" />
		<param name="baud" type="int" value="$(arg baud)" />
		<param name="state_rate" value="$(arg state_rate)" />
    </node>
</launch>
