<launch>
  <arg name="environment" default="simulation"/>
  <arg name="startup_timeout_sec" default="600.0"/>
  <arg name="show_force_execute" default="false"/>
  <node pkg="mycobotpro630_gazebo" type="pro630_control_session.py" name="$(anon pro630_slider_session)" required="true" output="screen">
    <param name="feature" value="slider"/>
    <param name="environment" value="$(arg environment)" type="str"/>
    <param name="startup_timeout_sec" value="$(arg startup_timeout_sec)" type="double"/>
    <param name="show_force_execute" value="$(arg show_force_execute)" type="bool"/>
  </node>
</launch>
