<launch>
  <arg name="environment" default="simulation"/>
  <arg name="with_gripper" default="false"/>
  <arg name="allow_collision" default="false"/>
  <arg name="gazebo_gui" default="true"/>
  <arg name="pro630_ip" default="192.168.1.159"/>
  <arg name="pro630_port" default="5001"/>
  <arg name="real_snapshot_file" default="/tmp/mycobotpro630_real_initial_positions.yaml"/>
  <arg name="real_snapshot_timeout_sec" default="600.0"/>
  <arg name="initial_pose_tolerance_rad" default="0.01"/>
  <arg name="initial_pose_timeout_sec" default="20.0"/>
  <node pkg="mycobotpro630_gazebo" type="pro630_bringup.py" name="$(anon pro630_bringup)" output="screen" required="true">
    <param name="environment" value="$(arg environment)" type="str"/>
    <param name="with_gripper" value="$(arg with_gripper)" type="bool"/>
    <param name="allow_collision" value="$(arg allow_collision)" type="bool"/>
    <param name="gazebo_gui" value="$(arg gazebo_gui)" type="bool"/>
    <param name="pro630_ip" value="$(arg pro630_ip)" type="str"/>
    <param name="pro630_port" value="$(arg pro630_port)" type="int"/>
    <param name="real_snapshot_file" value="$(arg real_snapshot_file)" type="str"/>
    <param name="real_snapshot_timeout_sec" value="$(arg real_snapshot_timeout_sec)" type="double"/>
    <param name="initial_pose_tolerance_rad" value="$(arg initial_pose_tolerance_rad)" type="double"/>
    <param name="initial_pose_timeout_sec" value="$(arg initial_pose_timeout_sec)" type="double"/>
  </node>
</launch>
