<launch>
	<arg name="ip" default="192.168.0.232" />
	<arg name="port" default="4500" />
	<!-- Compatibility entry point for the legacy F100 launch command. -->
	<arg name="urdf" default="legacy" />
	<arg name="model" default="" />
	<arg name="rvizconfig" default="" />
	<arg name="gui" default="false" />
	<include file="$(find mycobot_pro_450)/launch/teleop_keyboard.launch">
		<arg name="ip" value="$(arg ip)" />
		<arg name="port" value="$(arg port)" />
		<arg name="urdf" value="$(arg urdf)" />
		<arg name="gripper" value="f100" />
		<arg name="model" value="$(arg model)" />
		<arg name="rvizconfig" value="$(arg rvizconfig)" />
		<arg name="gui" value="$(arg gui)" />
	</include>
</launch>
