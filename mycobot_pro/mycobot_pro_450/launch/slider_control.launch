<launch>
	<!-- Suppress RViz's ROS 1 end-of-life notification. -->
	<env name="DISABLE_ROS1_EOL_WARNINGS" value="1" />
	<arg name="urdf" default="legacy" />
	<arg name="gripper" default="none" />
	<arg name="model" default="" />
	<arg name="rvizconfig" default="" />

	<arg name="gui" default="true" />

	<include file="$(find mycobot_pro_450)/launch/pro450_description.launch">
		<arg name="urdf" value="$(arg urdf)" />
		<arg name="gripper" value="$(arg gripper)" />
		<arg name="model" value="$(arg model)" />
	</include>

	<!-- Combinejoin values to TF -->
	<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
	<!-- Force-gripper control uses a project-owned GUI without Randomize. -->
	<group if="$(eval arg('gripper') == 'f100')">
		<node name="joint_state_publisher_gui" pkg="mycobot_pro_450" type="safe_joint_state_publisher_gui.py">
			<param name="use_gui" value="$(arg gui)" />
		</node>
	</group>
	<group unless="$(eval arg('gripper') == 'f100')">
		<node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui">
			<param name="use_gui" value="$(arg gui)" />
			<!-- <rosparam param="source_list" subst_value="true">["joint_states"]</rosparam> -->
		</node>
	</group>
	<!-- Show in Rviz-->
	<group if="$(eval arg('rvizconfig') != '')">
		<node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)" required="true" />
	</group>
	<group if="$(eval arg('rvizconfig') == '' and arg('urdf') == 'v2' and arg('gripper') == 'f100')">
		<node name="rviz" pkg="rviz" type="rviz" args="-d $(find mycobot_pro_450)/config/pro450_new_structure_gripper.rviz" required="true" />
	</group>
	<group if="$(eval arg('rvizconfig') == '' and not (arg('urdf') == 'v2' and arg('gripper') == 'f100'))">
		<node name="rviz" pkg="rviz" type="rviz" args="-d $(find mycobot_pro_450)/config/mycobot_pro_450.rviz" required="true" />
	</group>
</launch>
