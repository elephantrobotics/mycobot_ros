<launch>
  <!-- By default we do not overwrite the URDF. Change the following to true to change the default behavior -->
  <arg name="load_robot_description" default="false"/>

  <!-- Select the matching semantic model and joint-limit overrides. -->
  <arg name="urdf" default="legacy"/>
  <arg name="model" default=""/>

  <!-- Validate even when another launch file already supplied the URDF. -->
  <param name="pro450_moveit_urdf_profile_valid"
         command="sh -c 'case &quot;$(arg urdf)&quot; in legacy|v2) printf true ;; *) echo &quot;Unsupported urdf profile: $(arg urdf). Supported values: legacy, v2&quot; &gt;&amp;2; exit 1 ;; esac'" />

  <!-- The name of the parameter under which the URDF is loaded -->
  <arg name="robot_description" default="robot_description"/>

  <!-- Reuse the shared Pro450 loader so all ROS features select the same URDF
       profile and receive the same early validation. MoveIt is currently
       configured for the no-gripper arm model. -->
  <include if="$(arg load_robot_description)" file="$(find mycobot_pro_450)/launch/pro450_description.launch">
    <arg name="urdf" value="$(arg urdf)"/>
    <arg name="gripper" value="none"/>
    <arg name="model" value="$(arg model)"/>
    <arg name="robot_description" value="$(arg robot_description)"/>
  </include>

  <!-- The semantic description that corresponds to the URDF -->
  <group if="$(eval arg('urdf') == 'legacy')">
    <param name="$(arg robot_description)_semantic" textfile="$(find mycobot_pro450_moveit)/config/firefighter.srdf" />
  </group>
  <group if="$(eval arg('urdf') == 'v2')">
    <param name="$(arg robot_description)_semantic" textfile="$(find mycobot_pro450_moveit)/config/pro450_v2.srdf" />
  </group>

  <!-- Load updated joint limits (override information from URDF) -->
  <group ns="$(arg robot_description)_planning">
    <rosparam if="$(eval arg('urdf') == 'legacy')" command="load" file="$(find mycobot_pro450_moveit)/config/joint_limits.yaml"/>
    <rosparam if="$(eval arg('urdf') == 'v2')" command="load" file="$(find mycobot_pro450_moveit)/config/joint_limits_v2.yaml"/>
    <rosparam command="load" file="$(find mycobot_pro450_moveit)/config/cartesian_limits.yaml"/>
  </group>

  <!-- Load default settings for kinematics; these settings are overridden by settings in a node's namespace -->
  <group ns="$(arg robot_description)_kinematics">
    <rosparam command="load" file="$(find mycobot_pro450_moveit)/config/kinematics.yaml"/>

  </group>

</launch>
